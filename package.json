{
  "name": "cfd-course",
  "private": true,
  "description": "Статический сайт курса — только dev-зависимости для автотестов (Слой 1: гигиена HTML/линков/JS-парса).",
  "scripts": {
    "test:js": "node scripts/check-js.mjs",
    "test:html": "html-validate \"*.html\" \"mke/*.html\" \"nm/*.html\" \"sem1/*.html\" \"sem2/*.html\" \"sph/*.html\"",
    "test:links": "linkinator . --config .linkinatorrc.json",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cfd \"vitest run\"",
    "test": "npm run test:js && npm run test:html && npm run test:links"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.28.2",
    "html-validate": "^9.2.2",
    "linkinator": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
